# AI Automation Pack — Caddy reverse proxy
# Local : docker compose --profile proxy up -d reverse-proxy
# Prod  : docker compose -f docker-compose.yml -f docker-compose.prod.yml up -d
#
# PROXY_SITE=:80              → HTTP local (profile proxy, ports 8088/8443)
# PROXY_SITE=app.example.com  → TLS Let's Encrypt (overlay prod, ports 80/443)
# PROXY_ACME_EMAIL            → contact ACME (prod)

{
	# Compose injecte toujours une valeur (défaut caddy@localhost.invalid si vide).
	email {$PROXY_ACME_EMAIL}
}

# Health interne (non publié sur l'hôte) — healthcheck Compose.
:9080 {
	bind 127.0.0.1
	respond /readyz "ok" 200
}

{$PROXY_SITE::80} {
	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	# Public webhooks → backend (frontend nginx ne proxifie que /api/)
	handle /webhook* {
		reverse_proxy backend:8080 {
			header_up X-Real-IP {remote_host}
			transport http {
				read_timeout 60s
				write_timeout 60s
			}
		}
	}

	# SPA + /api (nginx frontend) — timeouts longs pour Ollama CPU
	handle {
		reverse_proxy frontend:80 {
			header_up X-Real-IP {remote_host}
			transport http {
				read_timeout 360s
				write_timeout 360s
			}
		}
	}
}
