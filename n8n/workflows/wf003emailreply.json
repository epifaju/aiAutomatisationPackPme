{
  "id": "wf003emailreply",
  "name": "[AIPACK][EMAIL] Reply generation",
  "description": "Produces a suggested reply via backend analyze. Never auto-sends (AI_GENERATED_EMAIL_AUTO_SEND=false). · v1.1.0",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "aipack/email/reply",
        "responseMode": "lastNode",
        "authentication": "headerAuth",
        "options": {}
      },
      "id": "wf003emailreply-hook",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [
        240,
        300
      ],
      "webhookId": "wf003emailreply-hook",
      "credentials": {
        "httpHeaderAuth": {
          "id": "aipack-webhook-header",
          "name": "AIPACK Backend Webhook"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const item = $input.first().json;\nconst body = item.body && typeof item.body === 'object' ? item.body : item;\nconst companyId = body.companyId || 'aaaaaaaa-0000-4000-8000-000000000001';\nconst payload = { ...body, companyId, analyze: true };\nreturn [{ json: payload }];"
      },
      "id": "wf003emailreply-code",
      "name": "Prepare payload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        460,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://backend:8080/webhook/email/incoming",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json) }}",
        "options": {
          "timeout": 180000
        }
      },
      "id": "wf003emailreply-http",
      "name": "Backend",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        680,
        300
      ],
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 2000,
      "credentials": {
        "httpHeaderAuth": {
          "id": "aipack-webhook-header",
          "name": "AIPACK Backend Webhook"
        }
      }
    }
  ],
  "connections": {
    "Webhook": {
      "main": [
        [
          {
            "node": "Prepare payload",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Prepare payload": {
      "main": [
        [
          {
            "node": "Backend",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "timezone": "Europe/Paris",
    "callerPolicy": "workflowsFromSameOwner",
    "errorWorkflow": "wf091errorhandl"
  },
  "staticData": null,
  "meta": {
    "templateCredsSetupCompleted": true
  },
  "pinData": {},
