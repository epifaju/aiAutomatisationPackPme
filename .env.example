# =============================================================================
# AI Automation Pack for TPE/PME — variables d'environnement
# Copier vers .env et adapter. Ne jamais committer .env.
# Valeurs ci-dessous = placeholders de développement, pas des secrets réels.
# =============================================================================

# --- Application ---
# development | production (alias: prod). En production, le backend refuse de démarrer
# si JWT_SECRET / WEBHOOK_SECRET / POSTGRES_PASSWORD / MINIO_* sont encore des placeholders.
APP_ENV=development
# Seed démo Flyway (R__demo_data) + compte demo.admin. Vide = auto (on hors prod, off en prod).
# DEMO_SEED_ENABLED=false
APP_BASE_URL=http://localhost:5173
COMPOSE_PROJECT_NAME=ai-automation-pack

# --- PostgreSQL ---
# POSTGRES_PORT = publication hôte uniquement ; les services parlent à postgres:5432.
POSTGRES_DB=aipack
POSTGRES_USER=aipack
POSTGRES_PASSWORD=aipack-dev-change-me
POSTGRES_PORT=5432

# --- n8n ---
N8N_HOST=localhost
N8N_PORT=5678
# Doit correspondre au port hôte N8N_PORT (ex. http://localhost:5677/ si 5677).
N8N_WEBHOOK_URL=http://localhost:5678/
N8N_ENCRYPTION_KEY=change-me-n8n-encryption-key-32b
N8N_DB=n8n
# Compte owner (créé par n8n-init via POST /rest/owner/setup — idempotent). Changer en prod.
N8N_OWNER_EMAIL=n8n.owner@aipack.example
N8N_OWNER_PASSWORD=change-me-n8n-owner-password
N8N_OWNER_FIRST_NAME=Owner
N8N_OWNER_LAST_NAME=AIPACK
DEMO_COMPANY_ID=aaaaaaaa-0000-4000-8000-000000000001

# --- Backend / Frontend ---
BACKEND_PORT=8080
FRONTEND_PORT=5173
CORS_ALLOWED_ORIGINS=

# --- Auth (JWT HS256, minimum 32 caractères) ---
JWT_SECRET=change-me-jwt-secret-min-32-characters-long
# Cookie refresh HttpOnly (P1.3) : auto = Secure si APP_ENV=production
JWT_COOKIE_NAME=aipack_refresh
JWT_COOKIE_SECURE=auto

# --- Webhooks (P1.1 : secret par entreprise ; cette valeur est liée au tenant démo au boot) ---
WEBHOOK_SECRET=change-me-webhook-secret-min-16-chars

# --- Rate limiting (Bucket4j, in-memory par IP) ---
RATE_LIMIT_ENABLED=true
RATE_LIMIT_TRUST_FORWARDED_HEADERS=false
RATE_LIMIT_AUTH_CAPACITY=20
RATE_LIMIT_AUTH_REFILL=1m
RATE_LIMIT_WEBHOOK_CAPACITY=120
RATE_LIMIT_WEBHOOK_REFILL=1m

# --- Emails (M01) — ne jamais auto-envoyer une réponse IA sans activation explicite (PRD §10) ---
AI_GENERATED_EMAIL_AUTO_SEND=false

# --- Factures (M04) — relances jamais auto-envoyées sans activation explicite ; J+30 toujours manuel ---
INVOICE_REMINDER_AUTO_SEND=false
INVOICE_REMINDER_FROM=relances@demo.aipack.example

# --- Rapport quotidien (M05) — envoi auto off par défaut ---
DAILY_REPORT_AUTO_SEND=false
DAILY_REPORT_FROM=rapports@demo.aipack.example

# --- IA (Ollama local par défaut, ou API cloud) ---
# AI_PROVIDER=ollama | openai (alias: openai-compatible, external) | anthropic (alias: claude)
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://ollama:11434
# Modèle Ollama. Sur CPU lent, préférer llama3.2:1b (plus rapide). llama3.2 (~3B) si GPU/CPU rapide.
OLLAMA_MODEL=llama3.2:1b
OLLAMA_PORT=11434
# Garde le modèle chargé en RAM (-1 = indéfini). Utile sur CPU.
OLLAMA_KEEP_ALIVE=-1
# Premier appel après chargement du modèle : souvent plusieurs minutes sur CPU.
# Une analyse email = 2 appels (classification + réponse) → laisser de la marge.
# Sur machine CPU lente, 900s (15 min) évite le faux "IA indisponible".
AI_TIMEOUT=900s
# Timeout client Playwright pour les appels IA (ms).
E2E_AI_TIMEOUT_MS=420000
# Provider OpenAI-compatible (Chat Completions). Requis si AI_PROVIDER=openai.
# Ex. OpenAI : base https://api.openai.com/v1 — Mistral : https://api.mistral.ai/v1
AI_OPENAI_BASE_URL=https://api.openai.com/v1
AI_OPENAI_API_KEY=
AI_OPENAI_MODEL=gpt-4o-mini
# Désactiver si l’endpoint compatible ne gère pas response_format=json_object
AI_OPENAI_JSON_MODE=true
# Provider Anthropic natif (Messages API). Requis si AI_PROVIDER=anthropic
AI_ANTHROPIC_BASE_URL=https://api.anthropic.com
AI_ANTHROPIC_API_KEY=
AI_ANTHROPIC_MODEL=claude-3-5-haiku-latest

# --- SMTP (Mailpit en développement) ---
# SMTP_HOST/SMTP_PORT = adresse vue par les conteneurs (réseau Docker).
# MAILPIT_*_HOST_PORT = ports publiés sur la machine hôte (modifiables si collision).
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
MAILPIT_SMTP_HOST_PORT=1025
MAILPIT_UI_PORT=8025

# --- MinIO (stockage objet) ---
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin-change-me
MINIO_BUCKET=aipack
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# --- Documents / OCR (Tesseract dans l'image backend) ---
DOCUMENT_MAX_SIZE_BYTES=20971520
DOCUMENT_OCR_ENABLED=true
DOCUMENT_OCR_LANGUAGES=fra+eng
DOCUMENT_OCR_MIN_CHARS=40

# --- ClamAV (P1.4 : on + fail-closed en production ; profile "clamav" en local) ---
# Vide = auto (enabled/fail-closed si APP_ENV=production|prod).
CLAMAV_ENABLED=
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
CLAMAV_HOST_PORT=3310
CLAMAV_TIMEOUT=10s
CLAMAV_FAIL_OPEN=

# --- Redis (cache IA — requirepass ; le stack démarre avec ; AI_CACHE_ENABLED=false = cache off) ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=change-me-redis-password

# --- Reverse proxy Caddy ---
# Local (ports internes toujours publiés) : docker compose --profile proxy  → http://localhost:8088
# Prod P0.5 (seuls 80/443) : docker compose -f docker-compose.yml -f docker-compose.prod.yml up -d
#   PROXY_SITE=app.exemple.com
#   PROXY_ACME_EMAIL=admin@exemple.com
#   APP_BASE_URL=https://app.exemple.com
PROXY_HTTP_PORT=8088
PROXY_HTTPS_PORT=8443
PROXY_SITE=:80
# Prod TLS : email réel (Let's Encrypt). Défaut Compose si vide : caddy@localhost.invalid
PROXY_ACME_EMAIL=caddy@localhost.invalid
